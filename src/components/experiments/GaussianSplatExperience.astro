---
import {
  ArrowLeft,
  CircleQuestionMark,
  Expand,
  Gauge,
  Languages,
  Move3d,
  Navigation,
  Orbit,
  Pause,
  Play,
  RotateCcw,
  SlidersHorizontal,
  X,
} from '@lucide/astro';
import type { Locale } from '@/i18n/config';
import { SPLAT_SCENES } from '@/scripts/gaussian-splat/scenes';
import CustomSelect from '@/components/CustomSelect.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'zh-CN' } = Astro.props;
const isEnglish = locale === 'en';
const copy = isEnglish
  ? {
      back: 'Back to projects',
      language: '查看中文版本',
      eyebrow: 'Spatial Computing Experiment · 02',
      title: 'Gaussian Splat',
      description:
        'Explore a captured space reconstructed as millions of translucent 3D Gaussians.',
      enter: 'Load 3D scene',
      note: 'SPZ · Spark · Three.js · 7.6 MB',
      loading: 'Loading spatial scene',
      interactionOrbit: 'Drag to orbit · Scroll to zoom',
      interactionFly: 'Drag to look · WASD move · Q/E ascend/descend',
      cameraMode: 'Camera mode',
      orbit: 'Orbit',
      fly: 'Fly',
      reset: 'Reset view',
      pause: 'Pause rotation',
      play: 'Auto rotate',
      fullscreen: 'Fullscreen',
      quality: 'Quality',
      performance: 'Performance',
      enablePerformance: 'Enable performance mode',
      disablePerformance: 'Use quality mode',
      help: {
        toggle: 'Help',
        title: 'Explore the scene',
        close: 'Close help',
        orbitTitle: 'Orbit camera',
        orbitText: 'Drag to orbit around the scene and scroll to zoom.',
        flyTitle: 'Fly camera',
        flyText:
          'Drag to look, use W/A/S/D to move, Q/E to change height, and hold Shift to accelerate.',
        performanceTitle: 'Performance mode',
        performanceText:
          'Reduces render resolution and LoD density without changing your saved tuning values.',
        shortcuts: 'Shortcuts',
        resetText: 'Reset the current view',
        fullscreenText: 'Toggle fullscreen',
      },
      scene: 'Scene',
      sceneLoading: 'Switching scene…',
      failed:
        'The scene could not be loaded. Check WebGL support and try again.',
      sceneNames: {
        interior: 'Interior',
        'holo-cos': 'Meilizhou Church',
      } as Record<string, string>,
      panel: {
        toggle: 'Tune',
        title: 'Gaussian Parameters',
        reset: 'Reset to defaults',
        close: 'Close',
        sectionAppearance: 'Appearance',
        opacity: 'Opacity',
        recolor: 'Tint',
        maxSh: 'SH degree',
        sectionRender: 'Rendering',
        maxStdDev: 'Gaussian extent',
        focalAdjustment: 'Sharpness',
        falloff: 'Falloff',
        minAlpha: 'Alpha cutoff',
        minPixelRadius: 'Min pixel radius',
        maxPixelRadius: 'Max pixel radius',
        preBlurAmount: 'Pre-blur',
        sortRadial: 'Radial sorting',
        enable2DGS: '2D Gaussians',
        sectionLod: 'Level of Detail',
        lodSplatScale: 'Detail scale',
        lodRenderScale: 'Min splat pixels',
        sectionDof: 'Depth of Field',
        focalDistance: 'Focus distance',
        apertureAngle: 'Aperture angle',
        sectionFoveation: 'Foveation',
        coneFov0: 'Full-res cone',
        coneFov: 'Falloff cone',
        coneFoveate: 'Edge scale',
        behindFoveate: 'Behind scale',
      },
    }
  : {
      back: '查看项目详情',
      language: 'View in English',
      eyebrow: '空间计算实验 · 02',
      title: 'Gaussian Splat',
      description: '探索由数百万半透明三维高斯重建而成的真实空间。',
      enter: '加载 3D 场景',
      note: 'SPZ · Spark · Three.js · 7.6 MB',
      loading: '正在加载空间场景',
      interactionOrbit: '拖动环视 · 滚轮缩放',
      interactionFly: '拖动转向 · WASD 移动 · Q 上升 / E 下降',
      cameraMode: '相机模式',
      orbit: '环绕',
      fly: '飞行',
      reset: '重置视角',
      pause: '暂停旋转',
      play: '自动旋转',
      fullscreen: '全屏',
      quality: '画质',
      performance: '性能',
      enablePerformance: '开启性能模式',
      disablePerformance: '切换到画质模式',
      help: {
        toggle: '帮助',
        title: '场景操作指南',
        close: '关闭帮助',
        orbitTitle: '环绕相机',
        orbitText: '拖动鼠标环绕场景，使用滚轮缩放视图。',
        flyTitle: '飞行相机',
        flyText:
          '拖动鼠标改变方向，W/A/S/D 移动，Q/E 调整高度，按住 Shift 加速。',
        performanceTitle: '性能模式',
        performanceText:
          '降低渲染分辨率和 LoD 密度，但不会修改已保存的调参数据。',
        shortcuts: '快捷键',
        resetText: '重置当前视角',
        fullscreenText: '切换全屏',
      },
      scene: '场景',
      sceneLoading: '正在切换场景…',
      failed: '场景加载失败，请检查浏览器 WebGL 支持后重试。',
      sceneNames: {
        interior: '室内场景',
        'holo-cos': '美丽州教堂',
      } as Record<string, string>,
      panel: {
        toggle: '调参',
        title: '高斯参数',
        reset: '恢复默认',
        close: '关闭',
        sectionAppearance: '外观',
        opacity: '不透明度',
        recolor: '染色',
        maxSh: '球谐阶数',
        sectionRender: '渲染',
        maxStdDev: '高斯延展',
        focalAdjustment: '锐度',
        falloff: '衰减',
        minAlpha: 'Alpha 截断',
        minPixelRadius: '最小像素半径',
        maxPixelRadius: '最大像素半径',
        preBlurAmount: '预模糊',
        sortRadial: '径向排序',
        enable2DGS: '2D 高斯',
        sectionLod: '细节层次',
        lodSplatScale: '细节倍率',
        lodRenderScale: '最小像素',
        sectionDof: '景深',
        focalDistance: '对焦距离',
        apertureAngle: '光圈角度',
        sectionFoveation: '注视点',
        coneFov0: '全分辨率锥角',
        coneFov: '衰减锥角',
        coneFoveate: '边缘缩放',
        behindFoveate: '后方缩放',
      },
    };

const sceneOptions = SPLAT_SCENES.map((s) => ({
  id: s.id,
  name: copy.sceneNames[s.id] ?? s.name,
}));
---

<section
  class="splat-experience"
  data-splat-root
  data-state="intro"
  aria-labelledby="splat-title"
>
  <canvas data-splat-canvas aria-label={copy.title}></canvas>
  <div class="ambient" aria-hidden="true"></div>

  <nav
    class="experience-nav"
    aria-label={isEnglish ? 'Experience navigation' : '体验页导航'}
  >
    <a
      class="nav-pill"
      href={isEnglish ? '/en/projects' : '/projects/gaussian-splat-viewer'}
    >
      <ArrowLeft size={16} /><span>{copy.back}</span>
    </a>
    <a
      class="nav-pill"
      href={isEnglish
        ? '/experiments/gaussian-splat'
        : '/en/experiments/gaussian-splat'}
      hreflang={isEnglish ? 'zh-CN' : 'en'}
    >
      <Languages size={16} /><span>{copy.language}</span>
    </a>
  </nav>

  <div class="intro-panel" data-splat-intro>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="splat-title">{copy.title}</h1>
    <p class="description">{copy.description}</p>
    <button class="enter-button" type="button" data-load-splat>
      <Play size={17} fill="currentColor" />{copy.enter}
    </button>
    <p class="tech-note">{copy.note}</p>
  </div>

  <div class="loader" data-splat-loader hidden aria-live="polite">
    <span class="loader-mark" aria-hidden="true"></span>
    <strong
      data-loading-text={copy.loading}
      data-scene-loading-text={copy.sceneLoading}>{copy.loading}</strong
    >
    <span data-load-status>Preparing renderer…</span>
    <div class="load-track" aria-hidden="true"><span data-load-bar></span></div>
    <span data-load-value>0%</span>
  </div>

  <div class="viewer-hud" data-splat-hud hidden>
    <p>
      <Move3d size={15} />
      <span
        data-splat-interaction
        data-orbit-label={copy.interactionOrbit}
        data-fly-label={copy.interactionFly}>{copy.interactionOrbit}</span
      >
    </p>
    <div class="viewer-actions">
      <CustomSelect
        class="scene-switcher-select"
        label={copy.scene}
        size="md"
        direction="up"
        options={sceneOptions.map((s) => ({ value: s.id, label: s.name }))}
        value={sceneOptions[0]?.id}
        data-scene-select
      />
      <div class="camera-mode-group" role="group" aria-label={copy.cameraMode}>
        <button
          type="button"
          data-camera-mode="orbit"
          aria-pressed="true"
          title={copy.orbit}
        >
          <Orbit size={16} /><span>{copy.orbit}</span>
        </button>
        <button
          type="button"
          data-camera-mode="fly"
          aria-pressed="false"
          title={copy.fly}
        >
          <Navigation size={16} /><span>{copy.fly}</span>
        </button>
      </div>
      <button type="button" data-reset-view title={copy.reset}>
        <RotateCcw size={16} /><span>{copy.reset}</span>
      </button>
      <button
        type="button"
        data-toggle-rotation
        data-playing="true"
        data-play-label={copy.play}
        data-pause-label={copy.pause}
        title={copy.pause}
      >
        <Pause class="pause-icon" size={16} />
        <Play class="play-icon" size={16} />
        <span data-rotation-label>{copy.pause}</span>
      </button>
      <button
        type="button"
        data-performance-mode
        data-quality-label={copy.quality}
        data-performance-label={copy.performance}
        data-enable-label={copy.enablePerformance}
        data-disable-label={copy.disablePerformance}
        aria-pressed="false"
        title={copy.enablePerformance}
      >
        <Gauge size={16} /><span data-performance-mode-label
          >{copy.quality}</span
        >
      </button>
      <button type="button" data-toggle-panel title={copy.panel.toggle}>
        <SlidersHorizontal size={16} /><span>{copy.panel.toggle}</span>
      </button>
      <button type="button" data-open-help title={copy.help.toggle}>
        <CircleQuestionMark size={16} /><span>{copy.help.toggle}</span>
      </button>
      <button type="button" data-fullscreen title={copy.fullscreen}>
        <Expand size={16} /><span>{copy.fullscreen}</span>
      </button>
    </div>
  </div>

  <dialog
    class="help-dialog"
    data-help-dialog
    aria-labelledby="splat-help-title"
  >
    <div class="help-card">
      <header class="help-head">
        <div>
          <p>{copy.cameraMode}</p>
          <h2 id="splat-help-title">{copy.help.title}</h2>
        </div>
        <button type="button" data-close-help title={copy.help.close}>
          <X size={17} />
        </button>
      </header>
      <div class="help-body">
        <section>
          <Orbit size={19} />
          <div>
            <h3>{copy.help.orbitTitle}</h3>
            <p>{copy.help.orbitText}</p>
          </div>
        </section>
        <section>
          <Navigation size={19} />
          <div>
            <h3>{copy.help.flyTitle}</h3>
            <p>{copy.help.flyText}</p>
          </div>
        </section>
        <section>
          <Gauge size={19} />
          <div>
            <h3>{copy.help.performanceTitle}</h3>
            <p>{copy.help.performanceText}</p>
          </div>
        </section>
        <section class="shortcut-section">
          <Move3d size={19} />
          <div>
            <h3>{copy.help.shortcuts}</h3>
            <dl>
              <div><dt><kbd>R</kbd></dt><dd>{copy.help.resetText}</dd></div>
              <div>
                <dt><kbd>F</kbd></dt><dd>{copy.help.fullscreenText}</dd>
              </div>
            </dl>
          </div>
        </section>
      </div>
    </div>
  </dialog>

  <aside
    class="splat-panel"
    data-splat-panel
    data-open="false"
    aria-hidden="true"
  >
    <header class="panel-head">
      <h2>{copy.panel.title}</h2>
      <button type="button" data-close-panel title={copy.panel.close}>
        <X size={16} />
      </button>
    </header>

    <div class="panel-body">
      <section class="panel-group">
        <h3>{copy.panel.sectionAppearance}</h3>
        <label class="field">
          <span class="field-label">{copy.panel.opacity}</span>
          <span class="field-value" data-value-for="opacity">1</span>
          <input
            type="range"
            min="0"
            max="1"
            step="0.01"
            data-param="opacity"
          />
        </label>
        <label class="field field-color">
          <span class="field-label">{copy.panel.recolor}</span>
          <input type="color" data-param="recolor" />
        </label>
        <div class="field">
          <span class="field-label">{copy.panel.maxSh}</span>
          <CustomSelect
            class="param-select"
            size="sm"
            direction="up"
            align="right"
            data-param="maxSh"
            value="3"
            options={[
              { value: '0', label: '0' },
              { value: '1', label: '1' },
              { value: '2', label: '2' },
              { value: '3', label: '3' },
            ]}
          />
        </div>
      </section>

      <section class="panel-group">
        <h3>{copy.panel.sectionRender}</h3>
        <label class="field">
          <span class="field-label">{copy.panel.maxStdDev}</span>
          <span class="field-value" data-value-for="maxStdDev">2.83</span>
          <input
            type="range"
            min="2"
            max="3"
            step="0.01"
            data-param="maxStdDev"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.focalAdjustment}</span>
          <span class="field-value" data-value-for="focalAdjustment">1</span>
          <input
            type="range"
            min="0.5"
            max="3"
            step="0.05"
            data-param="focalAdjustment"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.falloff}</span>
          <span class="field-value" data-value-for="falloff">1</span>
          <input
            type="range"
            min="0"
            max="1"
            step="0.05"
            data-param="falloff"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.minAlpha}</span>
          <span class="field-value" data-value-for="minAlpha">0.002</span>
          <input
            type="range"
            min="0"
            max="0.05"
            step="0.001"
            data-param="minAlpha"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.minPixelRadius}</span>
          <span class="field-value" data-value-for="minPixelRadius">0</span>
          <input
            type="range"
            min="0"
            max="16"
            step="0.5"
            data-param="minPixelRadius"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.maxPixelRadius}</span>
          <span class="field-value" data-value-for="maxPixelRadius">512</span>
          <input
            type="range"
            min="16"
            max="1024"
            step="1"
            data-param="maxPixelRadius"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.preBlurAmount}</span>
          <span class="field-value" data-value-for="preBlurAmount">0</span>
          <input
            type="range"
            min="0"
            max="1"
            step="0.05"
            data-param="preBlurAmount"
          />
        </label>
        <label class="field field-toggle">
          <span class="field-label">{copy.panel.sortRadial}</span>
          <input type="checkbox" data-bool-param="sortRadial" />
        </label>
        <label class="field field-toggle">
          <span class="field-label">{copy.panel.enable2DGS}</span>
          <input type="checkbox" data-bool-param="enable2DGS" />
        </label>
      </section>

      <section class="panel-group">
        <h3>{copy.panel.sectionLod}</h3>
        <label class="field">
          <span class="field-label">{copy.panel.lodSplatScale}</span>
          <span class="field-value" data-value-for="lodSplatScale">1</span>
          <input
            type="range"
            min="0.25"
            max="4"
            step="0.05"
            data-param="lodSplatScale"
          />
        </label>
        <label class="field">
          <span class="field-label">{copy.panel.lodRenderScale}</span>
          <span class="field-value" data-value-for="lodRenderScale">1</span>
          <input
            type="range"
            min="1"
            max="5"
            step="0.5"
            data-param="lodRenderScale"
          />
        </label>
      </section>

      <section class="panel-group" data-collapsible data-collapsed="true">
        <h3 data-collapse-trigger>{copy.panel.sectionDof}</h3>
        <div class="panel-group-body">
          <label class="field">
            <span class="field-label">{copy.panel.focalDistance}</span>
            <span class="field-value" data-value-for="focalDistance">0</span>
            <input
              type="range"
              min="0"
              max="50"
              step="0.5"
              data-param="focalDistance"
            />
          </label>
          <label class="field">
            <span class="field-label">{copy.panel.apertureAngle}</span>
            <span class="field-value" data-value-for="apertureAngle">0</span>
            <input
              type="range"
              min="0"
              max="0.5"
              step="0.01"
              data-param="apertureAngle"
            />
          </label>
        </div>
      </section>

      <section class="panel-group" data-collapsible data-collapsed="true">
        <h3 data-collapse-trigger>{copy.panel.sectionFoveation}</h3>
        <div class="panel-group-body">
          <label class="field">
            <span class="field-label">{copy.panel.coneFov0}</span>
            <span class="field-value" data-value-for="coneFov0">90</span>
            <input
              type="range"
              min="30"
              max="120"
              step="5"
              data-param="coneFov0"
            />
          </label>
          <label class="field">
            <span class="field-label">{copy.panel.coneFov}</span>
            <span class="field-value" data-value-for="coneFov">120</span>
            <input
              type="range"
              min="60"
              max="180"
              step="5"
              data-param="coneFov"
            />
          </label>
          <label class="field">
            <span class="field-label">{copy.panel.coneFoveate}</span>
            <span class="field-value" data-value-for="coneFoveate">0.4</span>
            <input
              type="range"
              min="0"
              max="1"
              step="0.05"
              data-param="coneFoveate"
            />
          </label>
          <label class="field">
            <span class="field-label">{copy.panel.behindFoveate}</span>
            <span class="field-value" data-value-for="behindFoveate">0.2</span>
            <input
              type="range"
              min="0"
              max="1"
              step="0.05"
              data-param="behindFoveate"
            />
          </label>
        </div>
      </section>
    </div>

    <footer class="panel-foot">
      <button type="button" data-panel-reset>{copy.panel.reset}</button>
    </footer>
  </aside>

  <p class="error-message" data-splat-error hidden role="alert">
    {copy.failed}
  </p>
  <noscript
    ><p class="error-message">This viewer requires JavaScript.</p></noscript
  >
</section>

<script>
  import type { GaussianSplatScene } from '@/scripts/gaussian-splat/GaussianSplatScene';
  import type { GaussianSplatPanel } from '@/scripts/gaussian-splat/GaussianSplatPanel';
  import {
    getDefaultPerformanceMode,
    PERFORMANCE_MODE_STORAGE_KEY,
    type CameraMode,
    type PerformanceMode,
  } from '@/scripts/gaussian-splat/GaussianSplatSettings';
  let splatScene: GaussianSplatScene | undefined;
  let splatPanel: GaussianSplatPanel | undefined;
  let pendingSplatScene: GaussianSplatScene | undefined;
  let splatCleanup: (() => void) | undefined;
  let splatMountVersion = 0;

  function loadPerformanceMode(): PerformanceMode {
    try {
      const stored = localStorage.getItem(PERFORMANCE_MODE_STORAGE_KEY);
      if (stored === 'quality' || stored === 'performance') return stored;
    } catch {
      /* localStorage unavailable; use the device-oriented default */
    }
    return getDefaultPerformanceMode();
  }

  function setupSplatExperience() {
    const root = document.querySelector<HTMLElement>('[data-splat-root]');
    if (!root || root.dataset.initialized === 'true') return;
    destroySplatExperience();
    root.dataset.initialized = 'true';
    const mountVersion = ++splatMountVersion;
    const isMounted = () =>
      mountVersion === splatMountVersion && root.isConnected;
    const loadButton =
      root.querySelector<HTMLButtonElement>('[data-load-splat]');
    const intro = root.querySelector<HTMLElement>('[data-splat-intro]');
    const loader = root.querySelector<HTMLElement>('[data-splat-loader]');
    const hud = root.querySelector<HTMLElement>('[data-splat-hud]');
    const errorMessage = root.querySelector<HTMLElement>('[data-splat-error]');
    const loadBar = root.querySelector<HTMLElement>('[data-load-bar]');
    const loadValue = root.querySelector<HTMLElement>('[data-load-value]');
    const loadStatus = root.querySelector<HTMLElement>('[data-load-status]');
    const rotationButton = root.querySelector<HTMLButtonElement>(
      '[data-toggle-rotation]',
    );
    const cameraButtons =
      root.querySelectorAll<HTMLButtonElement>('[data-camera-mode]');
    const performanceButton = root.querySelector<HTMLButtonElement>(
      '[data-performance-mode]',
    );
    const interactionLabel = root.querySelector<HTMLElement>(
      '[data-splat-interaction]',
    );
    const helpButton =
      root.querySelector<HTMLButtonElement>('[data-open-help]');
    const helpDialog =
      root.querySelector<HTMLDialogElement>('[data-help-dialog]');
    const panelEl = root.querySelector<HTMLElement>('[data-splat-panel]');
    const sceneSelect = root.querySelector<HTMLSelectElement>(
      '[data-scene-select] select',
    );
    const sceneSwitcher = root.querySelector<HTMLElement>(
      '[data-scene-select]',
    );
    const sceneLoadingLabel = root.querySelector<HTMLElement>(
      '[data-splat-loader] strong',
    );
    const initialPerformanceMode = loadPerformanceMode();

    const updateRotationButton = (playing: boolean) => {
      if (!rotationButton) return;
      const playLabel = rotationButton.dataset.playLabel ?? 'Auto rotate';
      const pauseLabel = rotationButton.dataset.pauseLabel ?? 'Pause rotation';
      rotationButton.dataset.playing = String(playing);
      rotationButton.title = playing ? pauseLabel : playLabel;
      const label = rotationButton.querySelector('[data-rotation-label]');
      if (label) label.textContent = playing ? pauseLabel : playLabel;
    };

    const updateCameraMode = (mode: CameraMode) => {
      cameraButtons.forEach((button) => {
        button.setAttribute(
          'aria-pressed',
          String(button.dataset.cameraMode === mode),
        );
      });
      if (interactionLabel) {
        interactionLabel.textContent =
          mode === 'fly'
            ? (interactionLabel.dataset.flyLabel ?? '')
            : (interactionLabel.dataset.orbitLabel ?? '');
      }
      if (rotationButton) {
        rotationButton.disabled = mode === 'fly';
        rotationButton.setAttribute('aria-disabled', String(mode === 'fly'));
      }
    };

    const updatePerformanceMode = (mode: PerformanceMode) => {
      if (!performanceButton) return;
      const enabled = mode === 'performance';
      performanceButton.setAttribute('aria-pressed', String(enabled));
      performanceButton.title = enabled
        ? (performanceButton.dataset.disableLabel ?? '')
        : (performanceButton.dataset.enableLabel ?? '');
      const label = performanceButton.querySelector<HTMLElement>(
        '[data-performance-mode-label]',
      );
      if (label) {
        label.textContent = enabled
          ? (performanceButton.dataset.performanceLabel ?? '')
          : (performanceButton.dataset.qualityLabel ?? '');
      }
    };

    updateCameraMode('orbit');
    updatePerformanceMode(initialPerformanceMode);

    const runWithProgress = async (
      fn: (onProgress: (p: number, s: string) => void) => Promise<void>,
    ): Promise<boolean> => {
      if (!isMounted()) return false;
      root.dataset.state = 'loading';
      loader?.removeAttribute('hidden');
      if (loadBar) loadBar.style.width = '0%';
      if (loadValue) loadValue.textContent = '0%';
      try {
        await fn((progress, status) => {
          if (!isMounted()) return;
          if (loadBar) loadBar.style.width = `${progress}%`;
          if (loadValue) loadValue.textContent = `${progress}%`;
          if (loadStatus) loadStatus.textContent = status;
        });
        if (!isMounted()) return false;
        root.dataset.state = 'active';
        errorMessage?.setAttribute('hidden', '');
        return true;
      } catch (error) {
        if (!isMounted()) return false;
        console.warn('Unable to load Gaussian splat scene.', error);
        root.dataset.state = 'error';
        errorMessage?.removeAttribute('hidden');
        return false;
      } finally {
        if (isMounted()) loader?.setAttribute('hidden', '');
      }
    };

    root.addEventListener('splat-auto-rotate-change', (event) => {
      updateRotationButton((event as CustomEvent<boolean>).detail);
    });
    root.addEventListener('splat-camera-mode-change', (event) => {
      updateCameraMode((event as CustomEvent<CameraMode>).detail);
    });
    root.addEventListener('splat-performance-mode-change', (event) => {
      const mode = (event as CustomEvent<PerformanceMode>).detail;
      updatePerformanceMode(mode);
      try {
        localStorage.setItem(PERFORMANCE_MODE_STORAGE_KEY, mode);
      } catch {
        /* Keep the in-memory preference when storage is unavailable. */
      }
    });

    loadButton?.addEventListener('click', async () => {
      if (!isMounted()) return;
      loadButton.disabled = true;
      const loaded = await runWithProgress(async (onProgress) => {
        let scene: GaussianSplatScene | undefined;
        let panel: GaussianSplatPanel | undefined;
        const disposeCandidate = () => {
          panel?.dispose();
          if (panel && splatPanel === panel) splatPanel = undefined;
          if (!scene) return;
          if (pendingSplatScene === scene) pendingSplatScene = undefined;
          if (splatScene === scene) splatScene = undefined;
          scene.destroy();
        };

        try {
          const [{ GaussianSplatScene }, { GaussianSplatPanel }] =
            await Promise.all([
              import('@/scripts/gaussian-splat/GaussianSplatScene'),
              import('@/scripts/gaussian-splat/GaussianSplatPanel'),
            ]);
          if (!isMounted()) return;

          scene = new GaussianSplatScene(root);
          pendingSplatScene = scene;
          await scene.init(onProgress);
          if (!isMounted()) {
            disposeCandidate();
            return;
          }

          panel = new GaussianSplatPanel(root, (params) =>
            scene?.applyParams(params),
          );
          if (!isMounted()) {
            disposeCandidate();
            return;
          }

          if (pendingSplatScene === scene) pendingSplatScene = undefined;
          splatScene = scene;
          splatPanel = panel;
          scene.setPerformanceMode(initialPerformanceMode);
          updatePerformanceMode(scene.getPerformanceMode());
          panelEl?.setAttribute('aria-hidden', 'false');
          intro?.setAttribute('hidden', '');
          hud?.removeAttribute('hidden');
          scene.start();
        } catch (error) {
          disposeCandidate();
          throw error;
        }
      });
      if (isMounted() && !loaded) loadButton.disabled = false;
    });

    const switchScene = async (id: string) => {
      const scene = splatScene;
      if (!isMounted() || !scene || scene.getSceneId() === id) return;
      const originalText = sceneLoadingLabel?.textContent ?? '';
      if (sceneLoadingLabel && sceneLoadingLabel.dataset.sceneLoadingText) {
        sceneLoadingLabel.textContent =
          sceneLoadingLabel.dataset.sceneLoadingText;
      }
      if (sceneSelect) sceneSelect.disabled = true;
      sceneSwitcher?.classList.add('is-disabled');
      const loaded = await runWithProgress((onProgress) =>
        scene.loadScene(id, onProgress),
      );
      if (!isMounted() || splatScene !== scene) return;
      if (!loaded && scene.getSceneId() !== id) {
        // 加载失败时继续展示旧场景，并将下拉框还原为实际正在显示的场景。
        root.dataset.state = 'active';
        if (sceneSelect) {
          sceneSelect.value = scene.getSceneId();
          sceneSelect.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }
      if (sceneSelect) sceneSelect.disabled = false;
      sceneSwitcher?.classList.remove('is-disabled');
      if (sceneLoadingLabel) sceneLoadingLabel.textContent = originalText;
    };

    sceneSelect?.addEventListener('change', () => {
      const id = sceneSelect.value;
      void switchScene(id);
    });

    cameraButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const mode = button.dataset.cameraMode;
        if (mode === 'orbit' || mode === 'fly') {
          splatScene?.setCameraMode(mode);
        }
      });
    });

    performanceButton?.addEventListener('click', () => {
      const scene = splatScene;
      if (!scene) return;
      scene.setPerformanceMode(
        scene.getPerformanceMode() === 'performance'
          ? 'quality'
          : 'performance',
      );
    });

    root.querySelector('[data-reset-view]')?.addEventListener('click', () => {
      splatScene?.resetView();
    });
    rotationButton?.addEventListener('click', () => {
      splatScene?.toggleAutoRotate();
    });
    root.querySelector('[data-toggle-panel]')?.addEventListener('click', () => {
      splatPanel?.toggle();
    });
    root.querySelector('[data-close-panel]')?.addEventListener('click', () => {
      splatPanel?.setOpen(false);
    });
    const toggleFullscreen = () => {
      if (document.fullscreenElement) void document.exitFullscreen();
      else void root.requestFullscreen();
    };
    root
      .querySelector('[data-fullscreen]')
      ?.addEventListener('click', toggleFullscreen);

    helpButton?.addEventListener('click', () => {
      if (!helpDialog || helpDialog.open) return;
      splatScene?.setInputEnabled(false);
      helpDialog.showModal();
    });
    root.querySelector('[data-close-help]')?.addEventListener('click', () => {
      helpDialog?.close();
    });
    helpDialog?.addEventListener('click', (event) => {
      if (event.target === helpDialog) helpDialog.close();
    });
    helpDialog?.addEventListener('close', () => {
      splatScene?.setInputEnabled(true);
      if (isMounted()) helpButton?.focus();
    });

    const handleShortcut = (event: KeyboardEvent) => {
      if (event.metaKey || event.ctrlKey || event.altKey || helpDialog?.open) {
        return;
      }
      const target = event.target as HTMLElement | null;
      if (
        target?.matches('input, textarea, select, button') ||
        target?.isContentEditable
      ) {
        return;
      }
      if (event.code === 'KeyR') {
        event.preventDefault();
        splatScene?.resetView();
      } else if (event.code === 'KeyF') {
        event.preventDefault();
        toggleFullscreen();
      }
    };
    window.addEventListener('keydown', handleShortcut);
    splatCleanup = () => window.removeEventListener('keydown', handleShortcut);
  }

  function destroySplatExperience() {
    splatMountVersion += 1;
    splatCleanup?.();
    splatCleanup = undefined;
    splatPanel?.dispose();
    splatPanel = undefined;
    const scenes = new Set<GaussianSplatScene>();
    if (splatScene) scenes.add(splatScene);
    if (pendingSplatScene) scenes.add(pendingSplatScene);
    scenes.forEach((scene) => scene.destroy());
    splatScene = undefined;
    pendingSplatScene = undefined;
  }

  document.addEventListener('astro:page-load', setupSplatExperience);
  document.addEventListener('astro:before-swap', destroySplatExperience);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSplatExperience, {
      once: true,
    });
  } else {
    setupSplatExperience();
  }
</script>

