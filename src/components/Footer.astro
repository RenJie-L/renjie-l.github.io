---
import { localizedPath, type Locale, ui } from '@/i18n/config';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const year = new Date().getFullYear();
const t = ui[locale];
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <p class="footer-signature">
        <strong>Renjie</strong>
        <span class="footer-dot" aria-hidden="true">·</span>
        <span>{t.footerTagline}</span>
      </p>
      <p class="copyright">© {year} Renjie. Built with Astro.</p>
    </div>
    <div class="footer-side">
      <nav
        class="footer-links"
        aria-label={locale === 'en' ? 'Footer links' : '页脚链接'}
      >
        <a href={localizedPath('/rss.xml', locale)}>RSS</a><a
          href="mailto:renjie-l@foxmail.com">Email</a
        >
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 2.25rem 0;
    margin-top: 7rem;
    color: var(--muted);
  }
  .footer-inner {
    width: min(calc(100% - 2rem), var(--max));
    margin: auto;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .footer-identity,
  .footer-side {
    display: grid;
    gap: 0.55rem;
  }
  .footer-signature {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0;
  }
  .footer-inner strong {
    color: var(--text);
  }
  .footer-dot {
    color: var(--line);
  }
  .footer-side {
    justify-items: end;
  }
  .footer-links {
    display: flex;
    gap: 1.25rem;
  }
  .footer-links a:hover {
    color: var(--text);
  }
  .copyright {
    margin: 0;
    font-size: 0.82rem;
  }

  @media (max-width: 760px) {
    .footer-inner {
      align-items: stretch;
      flex-direction: column;
      gap: 1.35rem;
    }
    .footer-side {
      justify-items: start;
    }
  }
</style>
