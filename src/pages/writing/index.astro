---
import { getCollection } from 'astro:content';
import ArticleCard from '@/components/ArticleCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { byNewest, publishedOnly } from '@/lib/content';
const articles = (await getCollection('writing'))
  .filter(
    (article) => publishedOnly(article) && article.data.language === 'zh-CN',
  )
  .sort(byNewest);
const categories = [
  ...new Set(articles.map((article) => article.data.category)),
];
---

<BaseLayout
  title="文章"
  description="关于前端工程、AI 编程、智能体与强化学习的技术实践。"
  hasTranslation
>
  <div class="page-intro">
    <div class="container">
      <p class="eyebrow">Writing</p><h1>文章</h1><p>
        记录理解技术的过程，也沉淀构建产品的方法。关注前端工程、AI-assisted
        Development 与强化学习。
      </p>
    </div>
  </div>
  <section class="writing-layout container" data-writing-filter-root>
    <aside aria-label="文章主题">
      <p>主题</p><button
        class="active filter"
        type="button"
        data-category="all"
        data-label="全部"
        aria-controls="article-list"
        aria-pressed="true">全部 <span>{articles.length}</span></button
      >{
        categories.map((category) => (
          <button
            class="filter"
            type="button"
            data-category={category}
            data-label={category}
            aria-controls="article-list"
            aria-pressed="false"
          >
            {category}
            <span>
              {
                articles.filter((article) => article.data.category === category)
                  .length
              }
            </span>
          </button>
        ))
      }
      <p class="filter-status" data-filter-status aria-live="polite"></p>
    </aside>
    <div id="article-list" class="article-list">
      {
        articles.map((article) => (
          <div data-article-category={article.data.category}>
            <ArticleCard article={article} />
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
<script>
  let cleanupWritingFilters: (() => void) | undefined;

  function setupWritingFilters() {
    cleanupWritingFilters?.();

    const root = document.querySelector<HTMLElement>(
      '[data-writing-filter-root]',
    );
    if (!root) return;

    const filters = [...root.querySelectorAll<HTMLButtonElement>('.filter')];
    const articles = [
      ...root.querySelectorAll<HTMLElement>('[data-article-category]'),
    ];
    const status = root.querySelector<HTMLElement>('[data-filter-status]');
    const controller = new AbortController();

    const applyFilter = (category: string, announce = false) => {
      const selected =
        filters.find((button) => button.dataset.category === category) ??
        filters[0];
      if (!selected) return;

      filters.forEach((button) => {
        const active = button === selected;
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      let visibleCount = 0;
      articles.forEach((article) => {
        const visible =
          category === 'all' || article.dataset.articleCategory === category;
        article.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      if (announce && status) {
        status.textContent = `${selected.dataset.label ?? category}：显示 ${visibleCount} 篇文章`;
      }
    };

    filters.forEach((button) => {
      button.addEventListener(
        'click',
        () => applyFilter(button.dataset.category ?? 'all', true),
        { signal: controller.signal },
      );
    });

    const initialCategory =
      filters.find((button) => button.classList.contains('active'))?.dataset
        .category ?? 'all';
    applyFilter(initialCategory);

    cleanupWritingFilters = () => {
      controller.abort();
      cleanupWritingFilters = undefined;
    };
  }

  document.addEventListener('astro:page-load', setupWritingFilters);
  document.addEventListener('astro:before-swap', () => {
    cleanupWritingFilters?.();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupWritingFilters, {
      once: true,
    });
  } else {
    setupWritingFilters();
  }
</script>
<style>
  .writing-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    padding-top: 3rem;
  }
  aside {
    position: sticky;
    top: 6rem;
    align-self: start;
    display: grid;
    gap: 0.25rem;
  }
  aside > p {
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .filter {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 0;
    background: transparent;
    border-radius: 8px;
    color: var(--muted);
    text-align: left;
    cursor: pointer;
    font-size: 0.86rem;
  }
  .filter:hover,
  .filter.active {
    background: var(--surface-2);
    color: var(--text);
  }
  .filter span {
    font-size: 0.75rem;
  }
  .filter-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  @media (max-width: 760px) {
    .writing-layout {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    aside {
      position: static;
      display: flex;
      overflow-x: auto;
      padding-bottom: 0.5rem;
    }
    aside > p {
      display: none;
    }
    .filter {
      width: auto;
      white-space: nowrap;
    }
  }
</style>
