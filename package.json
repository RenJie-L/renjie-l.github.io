{
  "name": "renjie-l-github-io",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=9.6.5"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run lint && npm run format:check && npm run check",
    "check:staged": "lint-staged",
    "precommit": "npm run check:staged && npm run check",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.28.0",
    "@sparkjsdev/spark": "^2.1.0",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^7.1.6",
    "astro-mermaid": "^2.1.0",
    "gsap": "^3.15.0",
    "mermaid": "^11.16.0",
    "reading-time": "^1.5.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.1.11",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.2.2",
    "@eslint/js": "^9.31.0",
    "@pagefind/default-ui": "^1.3.0",
    "@types/three": "^0.185.1",
    "eslint": "^9.31.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,astro}": [
      "eslint",
      "prettier --check"
    ],
    "*.{css,md,mdx,json,yml,yaml}": "prettier --check"
  },
  "overrides": {
    "sharp": "0.35.3",
    "eslint": {
      "minimatch": {
        "brace-expansion": "1.1.18"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": {
        "brace-expansion": "5.0.9"
      }
    }
  }
}
